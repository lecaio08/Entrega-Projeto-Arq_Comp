# ---- loads (LB/LH/LBU/LHU) em todos os offsets; word0 = 0x80FF7F01
lb x1,0(x0)
lb x2,1(x0)
lb x3,2(x0)
lb x4,3(x0)
lbu x5,2(x0)
lbu x6,3(x0)
lh x7,0(x0)
lh x8,2(x0)
lhu x9,2(x0)
lhu x10,0(x0)
lw x11,4(x0)
lb x12,5(x0)
lb x13,7(x0)
lhu x14,6(x0)
lw x15,8(x0)
lb x16,8(x0)
lbu x17,11(x0)
lh x18,10(x0)
# ---- stores parciais (SB/SH) preservando os demais bytes
addi x19,x0,-1
sb x19,12(x0)
sb x19,15(x0)
sh x19,16(x0)
sh x19,18(x0)
addi x20,x0,291
sb x20,21(x0)
sh x20,22(x0)
sb x20,0(x0)
lw x21,12(x0)
lw x22,20(x0)
lw x23,0(x0)
lb x24,0(x0)
# ---- store seguido de load no mesmo endereco, load-use e store de valor carregado
sb x20,24(x0)
lb x25,24(x0)
sh x19,26(x0)
lh x26,26(x0)
lhu x27,26(x0)
lb x28,1(x0)
add x29,x28,x28
lbu x30,3(x0)
sb x30,29(x0)
lb x31,29(x0)
beq x0,x0,0
